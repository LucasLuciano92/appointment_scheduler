<% content_for :title, "Clientes" %>
<div class="page-heading"><div><p class="eyebrow">ADMINISTRACIÓN</p><h1>Clientes</h1></div><%= link_to "Agregar cliente", new_admin_customer_path, class: "button" %></div>
<div class="panel">
<% if @customers.empty? %>
  <p class="empty-state">Todavía no hay registros en esta página. Usá “Agregar cliente” para comenzar.</p>
<% else %>
  <div class="table-scroll"><table><thead><tr><th scope="col">Nombre</th><th scope="col">Email</th><th scope="col">Teléfono</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
  <tbody><% @customers.each do |record| %><tr><td><%= person_name(record) %></td><td><%= record.email_address %></td><td><%= record.phone.presence || "—" %></td><td><%= activation_badge(record) %></td><td class="row-actions"><%= link_to "Ver", admin_customer_path(record) %><%= link_to "Editar", edit_admin_customer_path(record) %></td></tr><% end %></tbody></table></div>
<% end %>
</div>
<%= render "admin/shared/pagination" %>
