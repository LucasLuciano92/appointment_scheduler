<% content_for :title, "Disponibilidad semanal" %>
<div class="page-heading"><div><p class="eyebrow">ADMINISTRACIÓN</p><h1>Disponibilidad semanal</h1></div><%= link_to "Agregar franja horaria", new_admin_availability_path, class: "button" %></div>
<div class="panel">
<% if @availabilities.empty? %>
  <p class="empty-state">Todavía no hay registros en esta página. Usá “Agregar franja horaria” para comenzar.</p>
<% else %>
  <div class="table-scroll"><table><thead><tr><th scope="col">Profesional</th><th scope="col">Día</th><th scope="col">Horario</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
  <tbody><% @availabilities.each do |record| %><tr><td><%= person_name(record.staff_member) %></td><td><%= I18n.t("weekdays.#{record.day_of_week}") %></td><td><%=  "#{record.start_time.strftime("%H:%M")} – #{record.end_time.strftime("%H:%M")}"  %></td><td><%= activation_badge(record) %></td><td class="row-actions"><%= link_to "Ver", admin_availability_path(record) %><%= link_to "Editar", edit_admin_availability_path(record) %></td></tr><% end %></tbody></table></div>
<% end %>
</div>
<%= render "admin/shared/pagination" %>
