<section class="panel form-panel">
  <%= render "admin/shared/errors", record: @service %>
  <%= form_with model: @service, scope: :service, url: (@service.persisted? ? admin_service_path(@service) : admin_services_path) do |form| %>
    <div class="field">
      <%= form.label :name, "Nombre" %>
      <%= form.text_field :name, required: true %>
    </div>
    <div class="field">
      <%= form.label :description, "Descripción" %>
      <%= form.text_area :description, rows: 3 %>
    </div>
    <div class="field">
      <%= form.label :image, "Imagen" %>
      <%= form.file_field :image, accept: "image/jpeg,image/png,image/webp" %>
      <small>JPEG, PNG o WebP de hasta 5 MB.</small>
    </div>
    <% if @service.image.attached? %>
      <div class="field checkbox">
        <%= check_box_tag "service[remove_image]", "1", false, id: "service_remove_image" %>
        <%= label_tag "service_remove_image", "Eliminar la imagen actual" %>
      </div>
    <% end %>
    <div class="form-grid">
      <div class="field">
        <%= form.label :duration_minutes, "Duración (minutos)" %>
        <%= form.number_field :duration_minutes, required: true, min: 1, step: 1 %>
      </div>
      <div class="field">
        <%= form.label :price, "Precio (#{Rails.configuration.x.business_currency})" %>
        <%= form.number_field :price, required: true, min: 0, step: "0.01" %>
      </div>
    </div>
    <div class="field checkbox">
      <%= form.check_box :active %>
      <%= form.label :active, "Activo" %>
    </div>
    <div class="form-actions">
      <%= form.submit "Guardar", class: "button" %>
      <%= link_to "Cancelar", admin_services_path, class: "button secondary" %>
    </div>
  <% end %>
</section>
