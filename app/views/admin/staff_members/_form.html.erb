<section class="panel form-panel">
<%= render "admin/shared/errors", record: @staff_member %>
<%= form_with model: @staff_member, scope: :staff_member, url: (@staff_member.persisted? ? admin_staff_member_path(@staff_member) : admin_staff_members_path) do |form| %>
<div class="form-grid"><div class="field"><%= form.label :first_name, "Nombre" %><%= form.text_field :first_name, required: true %></div>
<div class="field"><%= form.label :last_name, "Apellido" %><%= form.text_field :last_name, required: true %></div></div>
<div class="field"><%= form.label :email_address, "Email de contacto (opcional)" %><%= form.email_field :email_address %></div>
<div class="field"><%= form.label :phone, "Teléfono (opcional)" %><%= form.telephone_field :phone %></div>
<div class="field checkbox"><%= form.check_box :active %><%= form.label :active, "Activo" %></div>
<div class="form-actions"><%= form.submit "Guardar", class: "button" %><%= link_to "Cancelar", admin_staff_members_path, class: "button secondary" %></div>
<% end %>
</section>
