<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Administración" %> · Agenda</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin-shell">
    <a class="skip-link" href="#main">Ir al contenido</a>
    <header class="topbar">
      <%= link_to "Agenda", admin_root_path, class: "brand" %>
      <span class="brand-caption">Administración del salón</span>
      <% if current_admin %>
        <div class="account">
          <span><%= person_name(current_admin) %></span>
          <%= button_to "Cerrar sesión", admin_session_path, method: :delete, class: "button secondary" %>
        </div>
      <% end %>
    </header>
    <% if current_admin %>
      <nav class="navigation" aria-label="Administración">
        <% admin_navigation_items.each do |label, path| %>
          <%= admin_navigation_link(label, path) %>
        <% end %>
      </nav>
    <% end %>
    <main id="main" class="container">
      <% flash.each do |type, message| %>
        <div class="flash <%= type %>" role="<%= type == 'alert' ? 'alert' : 'status' %>">
          <%= message %>
        </div>
      <% end %>
      <%= yield %>
    </main>
    <footer class="footer">
      Agenda del salón · Horarios de <%= Time.zone.name %>
    </footer>
  </body>
</html>
